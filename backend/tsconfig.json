{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "verbatimModuleSyntax": true,          // ESM স্টাইলে import রাখো (relative import-এ .js ব্যবহার করো)
    "forceConsistentCasingInFileNames": true,
    "noEmit": false
  },
  "include": ["src"]
}
